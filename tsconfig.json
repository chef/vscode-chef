{
	"compilerOptions": {
		"module": "node16",
		"moduleResolution": "node16",
		"target": "ES2020",
		"outDir": "out",
		"sourceMap": true,
		"typeRoots": [
			"node_modules/@types",
			"typings/"
		],
		"types": ["node", "mocha"],
		"lib": [
			"ES2020"
		]
	},
	"include": [
		"extension.ts",
		"src/**/*.ts",
		"test/**/*.ts"
	]
}
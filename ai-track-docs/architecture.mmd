%% vscode-chef architecture with concrete repository path mapping

flowchart TD
    subgraph VSCode["VS Code Runtime"]
        ExtHost["Extension Host"]
        Problems["Problems Panel"]
        JsonLS["JSON Validation"]
        SnipEngine["Snippet Engine"]
        CmdPalette["Command Palette"]
    end

    subgraph Repo["Repository Paths"]
        ExtTs["extension.ts\nactivate(), validate(), validatePaths()"]
        Pkg["package.json\ncontributions + scripts"]
        JobSchema["schema/job-schema.json"]
        JobSnips["snippets/chef_job.json"]
        OtherSnips["snippets/*.json"]
        Grammars["syntaxes/*.plist | syntaxes/*.cson.json"]
        AutoGen["autogeneration/Rakefile"]
        CI[".github/workflows/ci.yml"]
    end

    subgraph HostDeps["Host Dependencies"]
        Cookstyle["cookstyle / rubocop"]
    end

    ExtHost --> ExtTs
    Pkg -->|"activation events + command IDs"| ExtTs
    ExtTs -->|"register command\nchef.validateEntireWorkspace"| CmdPalette

    %% Data flow 1: Ruby lint diagnostics
    ExtTs -->|"spawnSync --parallel -f j"| Cookstyle
    Cookstyle -->|"JSON offenses"| ExtTs
    ExtTs -->|"DiagnosticCollection.set(...)"| Problems

    %% Data flow 2: job schema validation
    Pkg -->|"jsonValidation: **/*job.json -> schema"| JsonLS
    JobSchema -->|"required fields + enums"| JsonLS
    JobSnips -->|"chef-job, chef-job-step, chef-job-group"| SnipEngine
    JsonLS -->|"inline errors/warnings for invalid job.json"| Problems

    %% Data flow 3: snippet generation + CI checks
    AutoGen -->|"regenerate selected snippet JSON"| OtherSnips
    CI -->|"jq validates snippets/*.json"| OtherSnips
    CI -->|"renders this diagram (Mermaid)"| Mermaid["ai-track-docs/architecture.mmd"]
    Pkg -->|"npx vsce package"| VSIX["vscode-chef.vsix"]

    Pkg --> Grammars
    Pkg --> JobSchema

{
  "Chef Habitat plan.sh (draft)": {
    "prefix": "hab-plan",
    "scope": "ruby",
    "description": "Draft a Chef Habitat plan.sh with common pkg_* settings.",
    "body": [
      "pkg_name=${1:myapp}",
      "pkg_origin=${2:myorigin}",
      "pkg_version=${3:0.1.0}",
      "pkg_maintainer=\"${4:Your Name <you@example.com>}\"",
      "pkg_license=('${5:Apache-2.0}')",
      "pkg_description=\"${6:Describe your package}\"",
      "pkg_upstream_url=${7:https://example.com}",
      "pkg_source=${8:https://example.com/src/${1}.tar.gz}",
      "pkg_filename=${9:${1}-${3}.tar.gz}",
      "pkg_shasum=${10:REPLACE_WITH_SHA256}",
      "pkg_deps=(${11:core/glibc})",
      "pkg_build_deps=(${12:core/coreutils core/make core/gcc})",
      "pkg_bin_dirs=(${13:bin})",
      "",
      "do_build() {",
      "  ${14:make}",
      "}",
      "",
      "do_install() {",
      "  ${15:make install PREFIX=\"$pkg_prefix\"}",
      "}"
    ]
  }
}

{
  "Chef Courier Job - Full scaffold": {
    "prefix": "chef-job",
    "scope": "json",
    "description": "Scaffold a complete Chef Courier job definition with target groups and a shell step.",
    "body": [
      "{",
      "  \"name\": \"${1:my-job}\",",
      "  \"description\": \"${2:Describe what this job does}\",",
      "  \"scheduleRule\": \"${3|immediate,0 9 * * 1-5,0 0 * * 0|}\",",
      "  \"exceptionRules\": [],",
      "  \"target\": {",
      "    \"executionType\": \"${4|sequential,parallel|}\",",
      "    \"groups\": [",
      "      {",
      "        \"timeoutSeconds\": ${5:240},",
      "        \"batchSize\": {",
      "          \"type\": \"${6|number,percent|}\",",
      "          \"value\": ${7:1}",
      "        },",
      "        \"distributionMethod\": \"${8|batching,rolling|}\",",
      "        \"successCriteria\": [",
      "          {",
      "            \"numRuns\": { \"type\": \"percent\", \"value\": 100 },",
      "            \"status\": \"${9|success,failure|}\"",
      "          }",
      "        ],",
      "        \"nodeListType\": \"${10|nodes,nodeGroup,filter|}\",",
      "        \"nodeIdentifiers\": [\"${11:node-name}\"]",
      "      }",
      "    ]",
      "  },",
      "  \"actions\": {",
      "    \"accessMode\": \"${12|agent,ssh,winrm|}\",",
      "    \"steps\": [",
      "      {",
      "        \"name\": \"${13:step-name}\",",
      "        \"interpreter\": {",
      "          \"skill\": {",
      "            \"minVersion\": \"${14:1.0.0}\",",
      "            \"maxVersion\": \"${15:1.9.99}\"",
      "          },",
      "          \"name\": \"${16|chef-platform/shell-interpreter,chef-platform/chef-client-interpreter|}\"",
      "        },",
      "        \"command\": {",
      "          \"linux\": [\"${17:echo hello}\"],",
      "          \"windows\": [\"${18:Write-Host hello}\"]",
      "        },",
      "        \"inputs\": {},",
      "        \"expectedInputs\": {},",
      "        \"outputFieldRules\": {},",
      "        \"retryCount\": ${19:0},",
      "        \"failureBehavior\": {",
      "          \"action\": \"${20|retryThenFail,fail,continue,retryThenContinue|}\",",
      "          \"retryBackoffStrategy\": {",
      "            \"type\": \"${21|linear,exponential,fixed|}\",",
      "            \"delaySeconds\": ${22:1},",
      "            \"arguments\": [${23:1, 3, 5}]",
      "          }",
      "        },",
      "        \"limits\": {},",
      "        \"conditions\": []",
      "      }",
      "    ]",
      "  }",
      "}"
    ]
  },
  "Chef Courier Job - Quick shell step": {
    "prefix": "chef-job-step",
    "scope": "json",
    "description": "Scaffold a single Chef Courier job step (paste inside the steps array).",
    "body": [
      "{",
      "  \"name\": \"${1:step-name}\",",
      "  \"interpreter\": {",
      "    \"skill\": {",
      "      \"minVersion\": \"${2:1.0.0}\",",
      "      \"maxVersion\": \"${3:1.9.99}\"",
      "    },",
      "    \"name\": \"${4|chef-platform/shell-interpreter,chef-platform/chef-client-interpreter|}\"",
      "  },",
      "  \"command\": {",
      "    \"linux\": [\"${5:echo hello}\"],",
      "    \"windows\": [\"${6:Write-Host hello}\"]",
      "  },",
      "  \"inputs\": {},",
      "  \"expectedInputs\": {},",
      "  \"outputFieldRules\": {},",
      "  \"retryCount\": ${7:0},",
      "  \"failureBehavior\": {",
      "    \"action\": \"${8|retryThenFail,fail,continue|}\",",
      "    \"retryBackoffStrategy\": {",
      "      \"type\": \"${9|linear,exponential,fixed|}\",",
      "      \"delaySeconds\": ${10:1},",
      "      \"arguments\": [${11:1, 3, 5}]",
      "    }",
      "  },",
      "  \"limits\": {},",
      "  \"conditions\": []",
      "}"
    ]
  },
  "Chef Courier Job - Node group": {
    "prefix": "chef-job-group",
    "scope": "json",
    "description": "Scaffold a single target group (paste inside the groups array).",
    "body": [
      "{",
      "  \"timeoutSeconds\": ${1:240},",
      "  \"batchSize\": {",
      "    \"type\": \"${2|number,percent|}\",",
      "    \"value\": ${3:1}",
      "  },",
      "  \"distributionMethod\": \"${4|batching,rolling|}\",",
      "  \"successCriteria\": [",
      "    {",
      "      \"numRuns\": { \"type\": \"percent\", \"value\": 100 },",
      "      \"status\": \"${5|success,failure|}\"",
      "    }",
      "  ],",
      "  \"nodeListType\": \"${6|nodes,nodeGroup,filter|}\",",
      "  \"nodeIdentifiers\": [\"${7:node-name}\"]",
      "}"
    ]
  }
}
